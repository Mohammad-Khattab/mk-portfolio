---
import Layout from "../layouts/Layout.astro";
import RevealScript from "../components/RevealScript.astro";
import { PROJECTS, ORDER } from "../data/projects";
import { CERTIFICATES } from "../data/certificates";
import { SITE } from "../data/site";

const projects = ORDER.map((id) => PROJECTS[id]);
---
<Layout title="Mohammad Khattab — Edge Intelligence Engineer">
  <main>
    <section class="wrap" style="padding:96px 40px 56px">
      <div style="display:flex;align-items:baseline;gap:14px;font-family:'Archivo Narrow',sans-serif;font-size:11px;letter-spacing:.26em;text-transform:uppercase;color:var(--ink-3);animation:fadeUp .7s .1s cubic-bezier(.2,.8,.2,1) both">
        <span>Amman, Jordan</span><span style="width:38px;height:1px;background:var(--line-2)"></span><span>Year 02 / 04</span>
      </div>
      <h1 style="margin:22px 0 0;font-weight:900;letter-spacing:-.035em;line-height:.9;font-size:clamp(48px,8.4vw,132px);text-transform:uppercase">
        <span style="display:block;overflow:hidden;padding-bottom:.02em"><span style="display:block;animation:riseIn 1s .05s cubic-bezier(.16,1,.3,1) both">Edge</span></span>
        <span style="display:block;overflow:hidden;padding-bottom:.02em"><span style="display:block;animation:riseIn 1s .17s cubic-bezier(.16,1,.3,1) both">Intelligence</span></span>
        <span style="display:block;overflow:hidden;padding-bottom:.02em"><span style="display:block;color:var(--ink-4);animation:riseIn 1s .29s cubic-bezier(.16,1,.3,1) both">Engineer</span></span>
      </h1>
      <div style="height:2px;background:var(--ink);transform-origin:left;margin:38px 0 0;animation:ruleDraw 1.1s .5s cubic-bezier(.16,1,.3,1) both"></div>
      <div class="hero-grid" style="padding-top:34px;animation:fadeUp .8s .62s cubic-bezier(.2,.8,.2,1) both">
        <p style="margin:0;font-size:clamp(17px,1.55vw,22px);line-height:1.5;max-width:46ch;text-wrap:pretty;color:var(--ink-2)">
          I am Mohammad, a second-year Computer Engineering student at Princess Sumaya University for Technology. I work where AI meets software and hardware: models that run on the device, servers I maintain myself, and circuits I solder at my desk. This is the running record of what I build.
        </p>
        <div class="spec-table">
          <div class="spec-row"><span>Focus</span><span>Edge / Embedded AI</span></div>
          <div class="spec-row"><span>Stack</span><span>C · Python · Linux</span></div>
          <div class="spec-row"><span>Hardware</span><span>ESP32 · Pi · Proxmox</span></div>
          <div class="spec-row"><span>Status</span><span>Open to internships</span></div>
        </div>
      </div>
    </section>

    <section id="work" class="wrap" style="padding:96px 40px 40px">
      <div class="section-head" data-reveal>
        <h2>Selected work</h2>
        <span class="label">Four projects · click to open documentation</span>
      </div>
      <div class="work-grid">
        {projects.map((p) => (
          <a href={`/projects/${p.id}/`} class="work-card" data-reveal>
            <div class="glyph">{p.glyph}</div>
            <div class="inner">
              <div style="display:flex;justify-content:space-between;font-family:'Archivo Narrow',sans-serif;font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:var(--ink-3)">
                <span>{p.index}</span><span>{p.kind}</span>
              </div>
              <h3>{p.title}</h3>
              <p>{p.summary}</p>
              <div style="display:flex;flex-wrap:wrap;gap:6px">
                {p.stack.slice(0, 3).map((s) => <span class="tag">{s.v.split(",")[0].split("(")[0].trim()}</span>)}
              </div>
              <div class="open-doc">Open documentation <span class="rule"></span></div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section id="about" class="wrap" style="padding:88px 40px">
      <div data-reveal class="about-grid" style="border-top:2px solid var(--ink);padding-top:26px">
        <div>
          <h2 style="margin:0 0 18px;font-size:clamp(22px,2.4vw,32px);font-weight:800;letter-spacing:-.02em;text-transform:uppercase">Where this is going</h2>
          <div style="width:180px;height:1px;background:var(--line-2)"></div>
        </div>
        <div style="display:grid;gap:26px">
          <p style="margin:0;font-size:18px;line-height:1.55;max-width:56ch;text-wrap:pretty;color:var(--ink-2)">The goal is AI systems engineering: models that ship on constrained hardware, where the interesting problems are latency, memory, thermals and power rather than another API call. Year one is the foundation — C, digital logic, Linux internals — and the projects here are how I stay ahead of the syllabus.</p>
          <div class="goals-grid" style="border-top:1px solid var(--line)">
            <div style="padding:16px 18px 16px 0;border-right:1px solid var(--line)"><div class="label" style="margin-bottom:8px">Now</div><div style="font-size:15px;line-height:1.45">Pi-hole DNS filtering live; Jarvis Phase 2 data cleaning</div></div>
            <div style="padding:16px 18px;border-right:1px solid var(--line)"><div class="label" style="margin-bottom:8px">Next</div><div style="font-size:15px;line-height:1.45">Homelab VPN, second node, Anthropic Academy</div></div>
            <div style="padding:16px 0 16px 18px"><div class="label" style="margin-bottom:8px">Later</div><div style="font-size:15px;line-height:1.45">Edge inference at silicon-adjacent scale</div></div>
          </div>
        </div>
      </div>
    </section>

    <section id="certificates" class="wrap" style="padding:0 40px 88px">
      <div class="section-head" data-reveal>
        <h2>Certificates</h2>
        <span class="label">Real progress · most recent first</span>
      </div>
      <div data-reveal>
        {CERTIFICATES.map((c) => (
          <div class="cert-row">
            <span style="font-family:'Archivo Narrow',sans-serif;font-size:12px;letter-spacing:.18em;color:var(--ink-3)">{c.year}</span>
            <span style="font-size:17px;font-weight:800;letter-spacing:-.01em">{c.title}</span>
            <span style="font-size:13px;color:var(--ink-2)">{c.issuer}</span>
            {c.url ? (
              <a href={c.url} target="_blank" rel="noopener noreferrer" style="font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-3)">{c.status}</a>
            ) : (
              <span style="font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-3)">{c.status}</span>
            )}
          </div>
        ))}
      </div>
    </section>

    <section id="contact" style="border-top:2px solid var(--ink);background:rgba(17,17,17,.96);color:var(--paper)">
      <div class="wrap" style="padding:72px 40px 56px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:48px;align-items:end">
        <div>
          <div style="font-family:'Archivo Narrow',sans-serif;font-size:11px;letter-spacing:.26em;text-transform:uppercase;opacity:.6;margin-bottom:16px">Contact</div>
          <h2 style="margin:0;font-size:clamp(34px,6vw,84px);font-weight:900;line-height:.92;letter-spacing:-.035em;text-transform:uppercase">Let's build<br>something</h2>
        </div>
        <div style="display:grid;gap:10px;font-size:13px;letter-spacing:.16em;text-transform:uppercase">
          <a href={`mailto:${SITE.email}`} style="color:var(--paper);padding-bottom:4px;border-bottom:1px solid rgba(244,244,243,.3)">Email</a>
          <a href={SITE.github} target="_blank" rel="noopener noreferrer" style="color:var(--paper);padding-bottom:4px;border-bottom:1px solid rgba(244,244,243,.3)">GitHub</a>
          <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer" style="color:var(--paper);padding-bottom:4px;border-bottom:1px solid rgba(244,244,243,.3)">LinkedIn</a>
        </div>
      </div>
      <div class="wrap" style="padding:0 40px 34px;font-family:'Archivo Narrow',sans-serif;font-size:11px;letter-spacing:.2em;text-transform:uppercase;opacity:.5">Mohammad · Amman, Jordan · Built and documented in the open</div>
    </section>
  </main>
  <RevealScript />
</Layout>

<style>
  .site-nav a:hover, a:hover { color: var(--ink); }
  #contact a:hover { border-bottom-color: var(--paper) !important; }
</style>
